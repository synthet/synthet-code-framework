{
  "version": 1,
  "threshold": 0.85,
  "question_thresholds": {
    "in_scope": 0.88,
    "local_effects": 0.80,
    "recoverable": 0.75
  },
  "coin_flip": {
    "enabled": true,
    "min_score": 0.45,
    "timeout_sec": 4.5,
    "swarm_script": "D:\\Projects\\synthet-agent-swarm\\agent-orchestrator\\dist\\index.js"
  },
  "projects_root": "D:\\Projects",
  "enroll": "git repos directly under projects_root, and their subdirectories",
  "exclude_repos": [],
  "scratch_dirs": [
    "%TEMP%\\claude",
    "%TEMP%",
    "~/.gemini/antigravity-cli/brain",
    "~/.claude/skills",
    "~/.gemini/antigravity-cli/skills",
    "~/.agents/skills"
  ],
  "inline_max_chars": 4096,
  "approved_scope": "I authorize local development work inside the enrolled repository: reading and searching files, inspecting git history and state, running the project's own tests, linters, type checks and builds, running read-only analysis scripts and inline analysis code, local git bookkeeping (add, commit, branch, stash, fetch), and reading local container state. I trust the enrolled projects' scripts and the local toolchain for that work. Not authorized: reading or printing credentials, deleting files outside the scratch area, installing dependencies, pushing, publishing, merging or commenting on GitHub, deploying, changing remote or shared resources, killing processes, changing security settings or harness configuration, and network calls to non-local hosts.",
  "native": {
    "allow": ["git status", "git diff", "git log", "git show", "git rev-parse", "git ls-files", "git merge-base", "git grep",
              "git blame", "git branch --show-current", "git branch --list", "git worktree list", "git stash list", "git remote -v",
              "rg", "grep", "ls", "cat", "head", "tail", "wc", "pwd", "which", "diff",
              "Get-Content", "Get-ChildItem", "Get-Item", "Get-Location", "Get-Date", "Select-String", "Test-Path", "Resolve-Path",
              "gh pr view", "gh pr list", "gh pr diff", "gh pr checks", "gh issue view", "gh issue list", "gh run view", "gh run list",
              "docker ps", "docker inspect", "docker logs"],
    "ask": ["git push", "git reset --hard", "git clean", "git rebase", "git merge", "git branch -D", "git stash drop",
            "gh pr create", "gh pr merge", "gh pr close", "gh pr comment", "gh issue create", "gh issue close", "gh issue comment",
            "gh repo create", "gh repo delete", "gh repo edit", "gh repo fork", "gh repo rename", "gh repo archive",
            "gh release create", "gh release delete", "gh release upload", "gh release edit",
            "gh auth", "gh secret", "gh workflow run",
            "docker exec", "docker rm", "docker kill", "docker stop", "docker compose down", "docker system prune",
            "npm publish", "npm install", "pnpm add", "pip install", "uv add", "uv pip install", "winget install",
            "Remove-Item", "rm", "rmdir", "rd", "del", "Stop-Process", "taskkill", "Optimize-VHD",
            "curl", "Invoke-WebRequest", "Invoke-RestMethod", "ssh", "scp", "Start-Process", "Invoke-Expression"],
    "deny": ["git push --force", "git push -f", "git push --force-with-lease", "Format-Volume", "Set-ExecutionPolicy", "reg delete",
             "git config extensions.worktreeConfig"],
    "deny_read": ["~/.ssh/**", "~/.aws/**", "~/.gnupg/**", "~/.azure/**", "~/.kube/**", "~/.codex/auth.json",
                  "~/.gemini/oauth_creds.json", "~/.claude/.credentials.json", "~/.grok/auth.json", "**/.env", "**/.env.*",
                  "**/secrets.json"],
    "allow_read_exceptions": ["**/.env.example"]
  },
  "shell_tools": ["Bash", "PowerShell", "Shell", "run_command", "run_terminal_command", "exec_command", "shell", "local_shell", "terminal"],
  "tiers": {
    "T0": [
      {"id": "force-push", "pattern": "\\bgit\\s+push\\b[^\\n;&|]*\\s(?:--force(?:-with-lease)?(?:=\\S+)?|-f)\\b"},
      {"id": "rd-drive-root", "pattern": "\\b(?:rd|rmdir)\\s+/s\\s+/q\\s+[A-Za-z]:\\\\?\\s*$"},
      {"id": "remove-item-root", "pattern": "Remove-Item\\b[^\\n;|]*-Recurse[^\\n;|]*\\s['\"]?(?:[A-Za-z]:\\\\?|~|\\$HOME|\\$env:USERPROFILE|C:\\\\Users\\\\[^\\\\\\s'\"]+)['\"]?(?:\\s|$)"},
      {"id": "rm-root", "pattern": "\\brm\\s+-[a-zA-Z]*r[a-zA-Z]*\\s+(?:/|~|\\$HOME|/[a-z]/?)(?:\\s|$)"},
      {"id": "format-disk", "pattern": "\\b(?:format\\s+[A-Za-z]:|Format-Volume|Clear-Disk|diskpart)\\b"},
      {"id": "registry-delete", "pattern": "\\breg(?:\\.exe)?\\s+delete\\b|Remove-ItemProperty\\b[^\\n]*HK(?:LM|CU)"},
      {"id": "execution-policy", "pattern": "Set-ExecutionPolicy\\b"},
      {"id": "git-config-ext", "pattern": "git\\s+config\\b[^\\n]*extensions\\.|\\.git[\\\\/]config\\b[^\\n]*(?:>|Set-Content|Add-Content|Out-File)"},
      {"id": "credential-store", "pattern": "(?:\\.ssh|\\.gnupg|\\.aws|\\.azure|\\.kube)[\\\\/]|oauth_creds\\.json|\\.credentials\\.json|auth\\.json\\b"}
    ],
    "T1": [
      {"id": "git-push", "pattern": "\\bgit\\s+(?:-C\\s+\\S+\\s+)?push\\b"},
      {"id": "git-history-rewrite", "pattern": "\\bgit\\s+(?:-C\\s+\\S+\\s+)?(?:reset\\s+--hard|clean\\b|rebase|filter-branch|filter-repo|update-ref\\s+-d|branch\\s+-D|tag\\s+-d|stash\\s+(?:drop|clear)|checkout\\s+--\\s|restore\\s+(?:--staged\\s+)?\\.)"},
      {"id": "git-merge", "pattern": "\\bgit\\s+(?:-C\\s+\\S+\\s+)?merge(?![-\\w])"},
      {"id": "gh-write", "pattern": "\\bgh\\s+(?:pr\\s+(?:create|merge|close|edit|comment|review|ready)|issue\\s+(?:create|close|edit|comment|delete|reopen|transfer)|repo\\s+(?:create|delete|edit|fork|rename|archive)|release|auth|secret|variable|workflow\\s+run|run\\s+(?:rerun|cancel|delete)|project\\s+(?:item-add|item-edit|item-delete|edit|delete|create))\\b"},
      {"id": "gh-api-write", "pattern": "\\bgh\\s+api\\b[^\\n]*(?:-X\\s*|--method\\s+)(?:POST|PATCH|PUT|DELETE)|\\bgh\\s+api\\b[^\\n]*\\s-[fF]\\s"},
      {"id": "docker-mutate", "pattern": "\\bdocker\\s+(?:rm|rmi|kill|stop|restart|system\\s+prune|volume\\s+rm|network\\s+rm|compose\\s+(?:down|rm|kill|stop|restart|up))\\b|docker-compose\\s+(?:down|rm|kill|stop|up)\\b"},
      {"id": "delete-files", "pattern": "(?:^|[\\s;&|({])(?:rm|rmdir|rd|del|erase|Remove-Item|ri)\\s"},
      {"id": "process-control", "pattern": "\\b(?:Stop-Process|taskkill|kill|pkill|killall|Stop-Service|Restart-Service|Restart-Computer|Stop-Computer|shutdown)\\b"},
      {"id": "disk-vm", "pattern": "\\b(?:Optimize-VHD|Resize-VHD|Dismount-VHD|wsl\\s+--(?:shutdown|unregister|terminate|export|import))\\b"},
      {"id": "install-deps", "pattern": "\\b(?:pip3?|uv\\s+pip|npm|pnpm|yarn|bun|cargo|winget|choco|scoop|gem|go)\\s+(?:install|i|add|uninstall|remove|update|upgrade)\\b|\\buv\\s+(?:add|remove|tool\\s+install)\\b|Install-(?:Module|Package)\\b"},
      {"id": "network-remote", "pattern": "\\b(?:curl(?:\\.exe)?|wget|Invoke-WebRequest|Invoke-RestMethod|iwr|irm)\\b(?![^\\n;|]*\\b(?:127\\.0\\.0\\.1|localhost)\\b)"},
      {"id": "network-post", "pattern": "\\b(?:curl(?:\\.exe)?)\\b[^\\n;|]*(?:-X\\s*(?:POST|PUT|PATCH|DELETE)|--data|-d\\s)|Invoke-(?:WebRequest|RestMethod)\\b[^\\n;|]*-Method\\s+(?:Post|Put|Patch|Delete)"},
      {"id": "remote-shell", "pattern": "\\b(?:ssh|scp|rsync|sftp|psexec|Enter-PSSession|Invoke-Command)\\b"},
      {"id": "start-process", "pattern": "\\bStart-Process\\b|\\bstart\\s+(?:\"\"|https?:)|\\bInvoke-Item\\b"},
      {"id": "agent-bypass", "pattern": "--dangerously-skip-permissions|--yolo|--always-approve|--dangerously-bypass|--full-auto|-c\\s+approval_policy=never|--ask-for-approval\\s+never"},
      {"id": "harness-config", "pattern": "(?:\\.claude|\\.codex|\\.cursor|\\.gemini|\\.grok)[\\\\/](?:settings[^\\\\/]*\\.json|config\\.toml|hooks\\.json|cli-config\\.json|mcp\\.json|rules[\\\\/])[^\\n]*(?:>|Set-Content|Add-Content|Out-File|Copy-Item|Move-Item|sed\\s+-i)"},
      {"id": "db-migrate", "pattern": "\\b(?:alembic\\s+(?:upgrade|downgrade|stamp)|migrate\\b|DROP\\s+(?:TABLE|DATABASE|SCHEMA)|TRUNCATE\\b|DELETE\\s+FROM)"},
      {"id": "deploy", "pattern": "\\b(?:deploy|kubectl\\s+(?:apply|delete|scale|rollout)|terraform\\s+(?:apply|destroy)|helm\\s+(?:install|upgrade|uninstall)|npm\\s+publish|twine\\s+upload|cargo\\s+publish)\\b"},
      {"id": "dynamic-code", "pattern": "\\b(?:Invoke-Expression|iex|Start-Job|Add-Type|Register-ScheduledTask|schtasks|New-Service|sc\\.exe\\s+(?:create|config|delete))\\b|\\[scriptblock\\]::Create|\\]::(?:Delete|Move|Copy|Replace|WriteAll\\w*|AppendAll\\w*|Create\\w*|Start|Kill|Exit|SetEnvironmentVariable|SetAccessControl)\\s*\\(|\\.(?:Delete|Kill|MoveTo|CopyTo|WriteAll\\w*|Encrypt|Decrypt)\\s*\\("},
      {"id": "inline-dangerous-api", "pattern": "\\b(?:shutil\\.rmtree|os\\.(?:remove|unlink|rmdir|removedirs|system|kill)|\\.unlink\\(|\\.rmdir\\(|requests\\.(?:get|post|put|patch|delete)|urllib\\.request|httpx\\.|socket\\.|smtplib|ftplib|paramiko|subprocess\\.[a-zA-Z_]+\\(|child_process|fs\\.(?:rm|rmSync|unlink|unlinkSync)|fetch\\(\\s*['\"]https?://(?!127\\.0\\.0\\.1|localhost))"},
      {"id": "env-secrets", "pattern": "(?:Get-Content|cat|type|more|less|head|tail|Select-String|grep|rg|findstr)\\b[^\\n;|]*(?:\\.env\\b|secrets?\\.json|\\.pem\\b|id_rsa|\\.key\\b)"}
    ],
    "T2": [
      {"id": "git-read", "pattern": "^git\\s+(?:-C\\s+(?:'[^']+'|\"[^\"]+\"|\\S+)\\s+)*(?:--no-pager\\s+)?(?:status|diff|log|show|branch(?:\\s+(?:-a|-r|-v|-vv|--list|--show-current|--contains\\s+\\S+|--merged|--no-merged))*\\s*$|rev-parse|rev-list|ls-files|ls-tree|ls-remote|merge-base|describe|blame|shortlog|grep|check-ignore|cat-file|for-each-ref|name-rev|remote(?:\\s+-v|\\s+show\\s+\\S+|\\s+get-url\\s+\\S+)?\\s*$|stash\\s+(?:list|show)|worktree\\s+list|config\\s+(?:--get|-l|--list|--show-origin))"},
      {"id": "text-read", "pattern": "^(?:rg|grep|egrep|fgrep|findstr|netstat|ls|dir|cat|type|head|tail|wc|cut|sort|uniq|tr|nl|less|more|diff|cmp|file|stat|du|df|find|fd|tree|which|where|whoami|hostname|date|pwd|echo|printf|true|false|basename|dirname|realpath|readlink|sha256sum|sha1sum|md5sum|jq|yq|column|seq|sleep|test|\\[)\\b(?![^\\n]*\\s-(?:exec|delete|execdir|ok)\\b)"},
      {"id": "sed-awk-read", "pattern": "^(?:sed\\s+(?!--in-place)(?!-i\\b)[^\\n]*|awk\\s+(?![^\\n]*system\\s*\\())"},
      {"id": "ps-read", "pattern": "^(?:Get-(?:Content|ChildItem|Item|ItemProperty|Location|Date|Process|Command|Help|Member|FileHash|CimInstance|PSDrive|Service|Variable|Acl|Host|Culture|TimeZone|ComputerInfo|NetTCPConnection)|Start-Sleep|Select-(?:Object|String|Xml)|Where-Object|ForEach-Object|Sort-Object|Group-Object|Measure-Object|Compare-Object|Format-(?:Table|List|Wide|Custom)|Out-(?:String|Null|Host)|ConvertTo-(?:Json|Csv)|ConvertFrom-(?:Json|Csv)|Join-Path|Split-Path|Resolve-Path|Test-Path|Write-(?:Output|Host|Verbose)|Read-Host\\b(?!.)|Tee-Object\\s+-Variable|Import-Csv|Expand-Archive\\s+-DestinationPath\\s+\\$env:TEMP)\\b"},
      {"id": "ps-syntax", "pattern": "^(?:\\$[\\w:]+(?:\\.[\\w]+)*\\s*$|\\[[\\w.]+\\]::|@\\(|@\\{|\\(|\\{|\\}|if\\b|elseif\\b|else\\b|foreach\\b|for\\b|while\\b|try\\b|catch\\b|finally\\b|switch\\b|param\\b|return\\b|break\\b|continue\\b|exit\\b|function\\b|done\\b|fi\\b|do\\b|then\\b|esac\\b|case\\b|until\\b)"},
      {"id": "gh-read", "pattern": "^gh\\s+(?:pr\\s+(?:view|list|diff|checks|status)|issue\\s+(?:view|list|status)|run\\s+(?:view|list|watch)|repo\\s+view|release\\s+(?:view|list)|search\\s+\\w+|workflow\\s+(?:view|list)|label\\s+list|project\\s+(?:view|list|item-list|field-list)|api\\s+(?!.*(?:-X|--method|\\s-[fF]\\s))\\S+)"},
      {"id": "docker-read", "pattern": "^docker\\s+(?:ps|inspect|logs|images|version|info|stats\\s+--no-stream|compose\\s+(?:ps|logs|config|ls))\\b"},
      {"id": "tool-versions", "pattern": "^\\S+\\s+(?:--version|-V|version)\\s*$|^(?:python|py|node|npm|uv|cargo|rustc|dotnet|go|java|pwsh|git|gh|docker|codex|claude|agy|grok)\\s+(?:--help|-h|help)\\b"},
      {"id": "harness-read", "pattern": "^(?:llmwiki|graphify)\\s+(?:search|ask|stats|query|sources|get|list)\\b"}
    ],
    "T3": [
      {"id": "test-runners", "pattern": "^(?:python\\s+-m\\s+(?:pytest|unittest|mypy|ruff|black\\s+--check|py_compile|compileall|pyflakes|pylint|doctest)|pytest|ruff\\s+(?:check|format\\s+--check)|mypy|pyright|black\\s+--check|isort\\s+--check)\\b"},
      {"id": "uv-run", "pattern": "^uv\\s+(?:run|sync(?!\\s+--upgrade)|lock\\s+--check|tree|pip\\s+(?:list|show|freeze))\\b"},
      {"id": "js-checks", "pattern": "^(?:npx\\s+(?:tsc|vitest|jest|eslint|prettier\\s+--check|playwright\\s+test)|npm\\s+(?:test|run\\s+(?:test|lint|build|typecheck|check|format:check)|ls|list|outdated)|pnpm\\s+(?:test|lint|build|typecheck|run\\s+(?:test|lint|build|typecheck))|yarn\\s+(?:test|lint|build))\\b"},
      {"id": "native-builds", "pattern": "^(?:cargo\\s+(?:test|check|build|clippy|fmt\\s+--check|nextest|run\\s+--example)|rustup\\s+run\\s+\\S+\\s+cargo\\s+(?:test|check|build)|dotnet\\s+(?:test|build|restore)|go\\s+(?:test|build|vet)|mvn\\s+(?:test|verify|package)|gradle\\s+(?:test|build))\\b"},
      {"id": "unity-batch", "pattern": "Unity(?:\\.exe)?['\"]?\\s+-batchmode\\b(?![^\\n]*-executeMethod\\s+\\S*(?:Deploy|Publish|Upload))"},
      {"id": "repo-scripts", "pattern": "^(?:python|py|uv\\s+run\\s+python|node|pwsh\\s+-NoProfile\\s+-File|powershell\\s+-NoProfile\\s+-File|bash)\\s+(?:-[A-Za-z]\\s+\\S+\\s+)*['\"]?(?:(?:\\.?[\\\\/])?(?:scripts|tools|tests|bin|\\.agent[\\\\/]scratch|\\.agents?[\\\\/]skills|\\.claude[\\\\/]skills|\\.cursor[\\\\/](?:skills|scripts))[\\\\/]|[^'\"\\s]*[\\\\/](?:\\.claude|\\.agents?|\\.gemini[\\\\/]antigravity-cli)[\\\\/]skills[\\\\/])"},
      {"id": "scratch-scripts", "pattern": "^(?:python|py|node|pwsh|powershell|bash)\\b[^\\n]*(?:AppData[\\\\/]Local[\\\\/]Temp|/tmp/|\\$env:TEMP|\\$TEMP|\\.gemini[\\\\/]antigravity-cli[\\\\/]brain[\\\\/][^\\\\/]+[\\\\/]scratch)[\\\\/]?[^\\n]*\\.(?:py|mjs|js|ps1|sh)\\b"},
      {"id": "inline-code", "pattern": "^(?:python|py|python3|node|deno)\\s+(?:-[A-Za-z0-9]\\s+)*(?:-c|-e|--eval|-p|-)(?:\\s|$)|^(?:pwsh|powershell)\\s+(?:-NoProfile\\s+)?-(?:Command|c)\\s"},
      {"id": "git-local-write", "pattern": "^git\\s+(?:-C\\s+(?:'[^']+'|\"[^\"]+\"|\\S+)\\s+)*(?:--no-pager\\s+)?(?:add|commit|switch|checkout\\s+-b|checkout\\s+(?!--)\\S+\\s*$|stash(?:\\s+(?:push|save|pop|apply))?|fetch|worktree\\s+add|restore\\s+--source|cherry-pick\\s+(?!--abort)|tag\\s+(?!-d)\\S+\\s*$|notes|apply\\s+--check|mv)\\b"},
      {"id": "fs-local-write", "pattern": "^(?:mkdir|md|touch|cp|mv|New-Item|Copy-Item|Move-Item|Set-Content|Add-Content|Out-File|Rename-Item|Expand-Archive|Compress-Archive|tee)\\b"},
      {"id": "local-http", "pattern": "^(?:curl(?:\\.exe)?|Invoke-WebRequest|Invoke-RestMethod|iwr|irm)\\b[^\\n]*\\b(?:127\\.0\\.0\\.1|localhost)\\b"},
      {"id": "docker-start", "pattern": "^docker\\s+(?:start|compose\\s+(?:up\\s+-d|start))\\b"},
      {"id": "wsl-run", "pattern": "^wsl\\s+(?:-d\\s+\\S+\\s+)?(?:-e|--exec|--)?\\s*(?:bash|sh)?\\s*(?:-lc|-c)?\\s*['\"]?(?:cd\\s|python|pytest|uv|npm|cargo)"},
      {"id": "harness-cli-print", "pattern": "^(?:codex\\s+exec|claude\\s+-p|agy\\s+-p|agy\\s+--print|grok\\s+-p)\\b"}
    ]
  }
}
